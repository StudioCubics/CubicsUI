{
  "name": "cubicsui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "build:apps": "turbo build --filter=./apps/*",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "commitizen": "^4.3.2",
    "cz-cubics": "^0.0.10",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.8"
  }
}
