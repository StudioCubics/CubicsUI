    "@cubicsui/tsconfig": "workspace:^",
    "@cubicsui/types": "workspace:^",
    "@types/node": "24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "globals": "^17.4.0",
    "tsdown": "^0.21.9",
    "typescript": "^5"
  }
