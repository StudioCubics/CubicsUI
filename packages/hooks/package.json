{
  "name": "@cubicsui/hooks",
  "description": "Package containing important hooks by Studio Cubics",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "version": "0.0.0",
  "keywords": [
    "@cubicsui",
    "@studiocubics",
    "cubics",
    "studio",
    "react",
    "hooks"
  ],
  "author": {
    "name": "Ishfaq Ahmed",
    "email": "ishfaqahmed0837@gmail.com",
    "url": "https://studio-cubics.vercel.app"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint",
